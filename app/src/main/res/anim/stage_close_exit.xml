<?xml version="1.0" encoding="utf-8"?>
<!--
  the exit of the full-screen face, the whole window go together.

  why it must be window level animation rather than View -level animation —— this is"flash once on close" of
  real reason, measured:

  before StageActivity use `stage.animate().alpha(0f)` wind-down.stage is View
  tree, what shows through once it is transparent is not the one behind app, but**this Activity its own
  windowBackground**(pure black, see Theme.Body.Stage). Frame by frame, then, it looks like:

      64-72 frame   the picture dims          ← stage  of alpha 1→0
      72-86 frame   the whole screen pure black ~250ms   ← black background windowBackground shows through
      87 frame    the content behind fades in

  that middle 250ms neither, what the user said"flash once"that is it.View -level animation cannot reach
  windowBackground, because that layer isn't View; only window -level animation can fade the whole surface
  (content + black background)fade out together, what is behind shows through during the animation.

  scale slightly larger than the entrance(entrance 0.94), is to let"go"a sense of direction: retreat to a point farther than where it came from
  position, reads like you are going out, rather than shrink back the way it came.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_linear_in">
    <scale
        android:fromXScale="1.0"
        android:toXScale="0.90"
        android:fromYScale="1.0"
        android:toYScale="0.90"
        android:pivotX="50%"
        android:pivotY="50%" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
